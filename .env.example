# Project Settings
COMPOSE_PROJECT_NAME=oracle2clickhouse
NETWORK_NAME=${COMPOSE_PROJECT_NAME}-net

# Oracle Service
ORACLE_IMAGE_TAG=23.9-slim
ORACLE_HOST_PORT=1521
ORACLE_DATA_VOLUME=./volumes/oracle
ORACLE_SYS_PASSWORD=oracleadmin
ORACLE_APP_USER=bank
ORACLE_APP_USER_PASSWORD=oracleadmin

# MinIO Service
MINIO_IMAGE_TAG=RELEASE.2025-07-23T15-54-02Z
MINIO_HOST_PORT_API=9000
MINIO_HOST_PORT_CONSOLE=9001
MINIO_DATA_VOLUME=./volumes/minio
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ClickHouse Service
CLICKHOUSE_VERSION=25.8.7
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9010
CLICKHOUSE_DB=bank
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_ACCESS_MANAGEMENT=1
CLICKHOUSE_DATA_VOLUME=./volumes/clickhouse/data
CLICKHOUSE_LOG_VOLUME=./volumes/clickhouse/logs

# Airflow Service
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.0-python3.12
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=./src
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
AIRFLOW_DATA_VOLUME=./volumes/airflow
AIRFLOW__CORE__INTERNAL_API_SECRET_KEY=0ab8f504230a6aed94ec4648f9187f0b
AIRFLOW__API_AUTH__JWT_SECRET=0ab8f504230a6aed94ec4648f9187f0b